<div id="app" class="min-h-screen p-4 md:p-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Empleados</h1>
        <p class="text-sm text-slate-500">Listado de empleados registrados</p>
      </div>
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow transition hover:bg-teal-700 disabled:cursor-not-allowed disabled:opacity-50"
        :disabled="loading"
        @click="fetchEmployees"
      >
        {{ loading ? "Cargando..." : "Actualizar" }}
      </button>
    </div>

    <div
      v-if="error"
      class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
    >
      {{ error }}
    </div>

    <div class="overflow-hidden rounded-xl bg-white shadow">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Nombre</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Documento</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Teléfono</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Cargo</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Dirección</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Ciudad</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <tr v-if="loading">
            <td colspan="6" class="px-6 py-10 text-center text-sm text-slate-500">Cargando empleados...</td>
          </tr>
          <tr v-else-if="employees.length === 0">
            <td colspan="6" class="px-6 py-10 text-center text-sm text-slate-500">No hay empleados registrados.</td>
          </tr>
          <template v-else>
            <tr
              v-for="employee in employees"
              :key="employee.id"
              class="transition hover:bg-slate-50"
            >
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-slate-900">{{ employee.name }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">{{ employee.document }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">{{ employee.phone_number }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">{{ employee.position }}</td>
              <td class="px-6 py-4 text-sm text-slate-600">{{ employee.address }}</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">{{ employee.city }}</td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <p v-if="!loading && !error" class="mt-3 text-xs text-slate-500">
      Total: {{ employees.length }} empleados
    </p>
  </div>
</div>

<script>
  const { createApp } = Vue;

  createApp({
    data() {
      return {
        employees: [],
        loading: true,
        error: null
      };
    },
    mounted() {
      this.fetchEmployees();
    },
    methods: {
      async fetchEmployees() {
        this.loading = true;
        this.error = null;

        try {
          const response = await fetch("/api/v1/employees", {
            headers: { "Content-Type": "application/json" }
          });

          if (!response.ok) {
            throw new Error("No se pudo cargar el listado de empleados");
          }

          const data = await response.json();
          this.employees = data.employees || [];
        } catch (error) {
          this.error = error.message;
        } finally {
          this.loading = false;
        }
      }
    }
  }).mount("#app");
</script>
