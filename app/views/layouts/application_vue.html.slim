doctype html
html
  head
    title Empleados
    meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap", rel: "stylesheet"
    = javascript_include_tag "vue", debug: false
  body class="bg-slate-100"
    = yield
